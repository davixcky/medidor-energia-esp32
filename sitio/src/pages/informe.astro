---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { marked } from 'marked';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}/${p.replace(/^\//, '')}`;
const REPO = 'https://github.com/davixcky/medidor-energia-esp32/blob/main';

const bruto = readFileSync(resolve(process.cwd(), '../docs/informe.md'), 'utf-8');

/** Slug estable para los encabezados, compatible con las anclas del índice de GitHub. */
const slug = (texto: string) =>
  texto
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/[`*_[\]()]/g, '')
    .trim()
    .replace(/[^\p{L}\p{N}\s-]/gu, '')
    .replace(/\s+/g, '-');

const titulos: { nivel: number; texto: string; id: string }[] = [];

const renderer = new marked.Renderer();

renderer.heading = function ({ tokens, depth }) {
  const texto = this.parser.parseInline(tokens);
  const id = slug(texto);
  if (depth === 2 || depth === 3) titulos.push({ nivel: depth, texto, id });
  return `<h${depth} id="${id}">${texto}</h${depth}>\n`;
};

/**
 * El informe vive en docs/, así que sus rutas relativas empiezan por "../".
 * Las imágenes se sirven desde el propio sitio, pero scripts/preparar-assets.mjs
 * las copia aplanando carpetas: hay que traducir la ruta del repositorio a la del
 * sitio. Lo que no sea una imagen publicada se manda a GitHub, donde sí se abre.
 */
const esImagen = (h: string) => /\.(png|jpe?g|svg|gif|webp)$/i.test(h);

/** Debe coincidir con los destinos de scripts/preparar-assets.mjs. */
const DESTINOS: [RegExp, string][] = [
  [/^img\//, 'img/'],
  [/^stand\/img\//, 'img/'],
  [/^freecad\/revision-e7\//, 'render/'],
  [/^hardware\/perforadas-modulares\/schematic-previews\//, 'esquematicos/'],
];

const resolver = (href: string) => {
  if (/^(https?:|mailto:|#)/.test(href)) return href;
  const limpio = href.replace(/^\.\.\//, '');
  if (esImagen(limpio)) {
    for (const [patron, destino] of DESTINOS) {
      if (patron.test(limpio)) return url(limpio.replace(patron, destino));
    }
    // Imagen del repositorio que el sitio no publica: se sirve desde GitHub.
    return `https://raw.githubusercontent.com/davixcky/medidor-energia-esp32/main/${limpio}`;
  }
  return `${REPO}/${limpio}`;
};

renderer.link = function ({ href, title, tokens }) {
  const texto = this.parser.parseInline(tokens);
  const destino = resolver(href);
  const externo = /^https?:/.test(destino);
  return `<a href="${destino}"${title ? ` title="${title}"` : ''}${
    externo ? ' rel="noopener"' : ''
  }>${texto}</a>`;
};

renderer.image = function ({ href, title, text }) {
  return `<figure><img src="${resolver(href)}" alt="${text}" loading="lazy">${
    title ? `<figcaption>${title}</figcaption>` : ''
  }</figure>`;
};

renderer.table = function ({ header, rows }) {
  const th = header.map((c) => `<th>${this.parser.parseInline(c.tokens)}</th>`).join('');
  const tr = rows
    .map((fila) => `<tr>${fila.map((c) => `<td>${this.parser.parseInline(c.tokens)}</td>`).join('')}</tr>`)
    .join('');
  return `<div class="tabla-envoltura"><table><thead><tr>${th}</tr></thead><tbody>${tr}</tbody></table></div>`;
};

/**
 * El informe lleva matemáticas en LaTeX ($…$ y $$…$$), que GitHub renderiza pero
 * marked no. Se resuelven con KaTeX en tiempo de construcción: el HTML sale ya
 * compuesto y la página no carga JavaScript.
 *
 * Se comprobó que el informe no tiene ningún '$' dentro de bloques ni de código en
 * línea, así que estos tokenizadores no pueden pisar código. Si algún día se agrega
 * uno, habría que escaparlo.
 */
const matematicas = {
  extensions: [
    {
      name: 'blockMath',
      level: 'block' as const,
      start: (src: string) => src.indexOf('$$'),
      tokenizer(src: string) {
        const m = /^\$\$([\s\S]+?)\$\$/.exec(src);
        if (m) return { type: 'blockMath', raw: m[0], text: m[1].trim() };
      },
      renderer: (t: any) =>
        `<div class="math-bloque">${katex.renderToString(t.text, {
          displayMode: true,
          throwOnError: false,
        })}</div>`,
    },
    {
      name: 'inlineMath',
      level: 'inline' as const,
      start: (src: string) => src.indexOf('$'),
      tokenizer(src: string) {
        const m = /^\$([^$\n]+?)\$/.exec(src);
        if (m) return { type: 'inlineMath', raw: m[0], text: m[1] };
      },
      renderer: (t: any) =>
        katex.renderToString(t.text, { displayMode: false, throwOnError: false }),
    },
  ],
};

marked.use(matematicas as any);

const html = await marked.parse(bruto, { renderer, gfm: true, breaks: false });
---

<Base
  titulo="Informe del proyecto · Medidor de energía ESP32"
  descripcion="Documento académico completo: planteamiento, marco teórico, estado del arte, cálculos de componentes, diseño de PCB y gabinete, protocolo de pruebas y cronograma."
>
  <section class="cabecera-informe">
    <div class="envoltura">
      <span class="kicker">Documento académico · ABPr</span>
      <h1 class="mt-s">Informe del proyecto</h1>
      <p class="plomo estrecho mt">
        El documento completo tal como se entregó, con los cálculos de cada componente, el estado del
        arte, el protocolo de pruebas y el cronograma. Las ilustraciones se generan con los scripts
        del repositorio.
      </p>
      <div class="botones mt">
        <a class="boton boton-fantasma" href={`${REPO}/docs/informe.md`}>Ver el original en GitHub</a>
      </div>
    </div>
  </section>

  <div class="envoltura disposicion">
    <aside class="indice">
      <h4>Contenido</h4>
      <nav>
        {
          titulos.map((t) => (
            <a href={`#${t.id}`} class={t.nivel === 3 ? 'sub' : ''} set:html={t.texto} />
          ))
        }
      </nav>
    </aside>

    <article class="informe" set:html={html} />
  </div>
</Base>

<style>
  .cabecera-informe {
    padding: clamp(44px, 7vw, 76px) 0 40px;
    border-bottom: 1px solid var(--line);
  }

  .disposicion {
    display: grid;
    gap: 44px;
    padding-top: 44px;
    padding-bottom: 64px;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .disposicion { grid-template-columns: 250px minmax(0, 1fr); }
    .indice {
      position: sticky;
      top: calc(var(--nav) + 20px);
      max-height: calc(100vh - var(--nav) - 48px);
      overflow-y: auto;
      scrollbar-width: thin;
    }
  }

  .indice h4 {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tx3);
    margin-bottom: 12px;
  }
  .indice nav { display: grid; gap: 1px; }
  .indice a {
    font-size: 13.8px;
    color: var(--tx2);
    padding: 5px 10px;
    border-radius: 6px;
    border-left: 2px solid transparent;
    line-height: 1.4;
  }
  .indice a:hover { color: var(--tx); background: var(--panel); text-decoration: none; }
  .indice a.sub { padding-left: 22px; font-size: 13px; color: var(--tx3); }

  /* --------------------------------------------------- cuerpo del informe */

  .informe { min-width: 0; max-width: 78ch; font-size: 16.6px; }

  .informe :global(h2) {
    margin: 56px 0 18px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: clamp(25px, 3.6vw, 33px);
  }
  .informe :global(h2:first-child) { margin-top: 0; border-top: none; padding-top: 0; }
  .informe :global(h3) { margin: 38px 0 12px; font-size: clamp(19px, 2.4vw, 23px); }
  .informe :global(h4) { margin: 26px 0 8px; font-size: 17px; color: var(--tx); }

  .informe :global(p) { margin: 14px 0; }
  .informe :global(hr) { display: none; }

  .informe :global(ul),
  .informe :global(ol) { margin: 14px 0 14px 22px; }
  .informe :global(li) { margin: 7px 0; color: var(--tx2); }
  .informe :global(li::marker) { color: var(--verde); }

  .informe :global(blockquote) {
    margin: 20px 0;
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--line2);
    color: var(--tx3);
  }

  .informe :global(figure) { margin: 26px 0; }
  .informe :global(figure img) {
    border-radius: var(--radio-s);
    border: 1px solid var(--line);
    background: #fff;
    padding: 8px;
    width: 100%;
  }

  .informe :global(table) { font-size: 14.6px; }

  /* KaTeX: las ecuaciones de bloque se centran y pueden desplazarse si son anchas. */
  .informe :global(.math-bloque) {
    margin: 22px 0;
    padding: 4px 0;
    overflow-x: auto;
    overflow-y: hidden;
    text-align: center;
  }
  .informe :global(.katex) { color: var(--tx); font-size: 1.04em; }
  .informe :global(.math-bloque .katex) { font-size: 1.18em; }
  .informe :global(a) { text-decoration: underline; text-underline-offset: 2px; }

  /* Las referencias numeradas del final, más compactas. */
  .informe :global(h2[id^="9-"]) + :global(ol) { font-size: 15px; }
</style>
