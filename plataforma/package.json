{
  "name": "plataforma",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "simular": "node scripts/simular.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "exportar-lstm": "../pronostico/.venv/bin/python scripts/exportar_lstm.py",
    "capturas": "node scripts/capturas.ts",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.ts",
    "db:prueba": "docker run -d --rm --name medidor-pg-prueba -e POSTGRES_PASSWORD=prueba -p 54329:5432 postgres:17-alpine"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "nitro": "3.0.260610-beta",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.44",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "engines": {
    "node": ">=22.13"
  }
}
