# Copiar a .env (no se sube al repositorio) y completar.
# Cadena de conexión de Supabase: Project Settings → Database → Connection string.
# Para un servidor que corre siempre, la conexión directa o el pooler en modo sesión (puerto 5432);
# en un entorno sin servidor (serverless), el pooler en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
PORT=3000
# DEMO=1 corre sin base de datos: datos simulados en memoria (DATABASE_URL no se usa).
# DEMO=1
# TEMP_CONSTANTE=28
